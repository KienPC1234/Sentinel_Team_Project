# ShieldCall VN — Backend Environment Template
# Copy to backend/.env and adjust values for your environment.

# Core Django settings
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8001
SCAN_TOKEN_MAX_AGE=86400

# Database: sqlite3 (default, zero-setup) or mysql (MariaDB/MySQL)
DB_ENGINE=sqlite3
# DB_NAME=shieldcall_db
# DB_USER=shieldcall_user
# DB_PASSWORD=change_me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Redis (Channels WebSocket, Cache, Celery)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# AI & LLM Inference (Ollama local/cloud or OpenAI-compatible fallback)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
LLM_MODEL=deepseek-v4.1-flash:cloud
SMALL_MODEL=gemma4:31b-cloud

# Local AI service (VietOCR, Whisper, FAISS embeddings)
OCR_ENGINE=vietocr
VIETOCR_DEVICE=auto
AI_SERVICE_URL=http://127.0.0.1:5010
AI_EMBED_MODEL=BAAI/bge-m3
WHISPER_DEVICE=cpu
VECTOR_DB_USE_GPU=False
TTS_ENABLED=True
TTS_USE_CUDA=False

# Optional External Services (leave empty in local/offline evaluation)
VT_API_KEY=
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
USE_S3_MEDIA=False
USE_S3_STATIC=False
