# ───────────────────────────────────────────────────────────────────────────
# Object storage (S3-compatible) — dùng cho MEDIA & STATIC (an toàn, dễ mở rộng).
# Bật bằng USE_S3_MEDIA / USE_S3_STATIC; tắt → fallback FileSystem/Whitenoise.
# ───────────────────────────────────────────────────────────────────────────
USE_S3_MEDIA = os.getenv('USE_S3_MEDIA', 'False').lower() in ('true', '1', 'yes')
USE_S3_STATIC = os.getenv('USE_S3_STATIC', 'False').lower() in ('true', '1', 'yes')
AWS_ACCESS_KEY_ID = os.getenv('AWS_ACCESS_KEY_ID', '')
AWS_SECRET_ACCESS_KEY = os.getenv('AWS_SECRET_ACCESS_KEY', '')
AWS_STORAGE_BUCKET_NAME = os.getenv('AWS_STORAGE_BUCKET_NAME', 'shieldcall')
AWS_S3_REGION_NAME = os.getenv('AWS_S3_REGION_NAME', 'us-east-1')
AWS_S3_ENDPOINT_URL = os.getenv('AWS_S3_ENDPOINT_URL', '')
AWS_S3_CUSTOM_DOMAIN = os.getenv('AWS_S3_CUSTOM_DOMAIN', '')
AWS_S3_ADDRESSING_STYLE = os.getenv('AWS_S3_ADDRESSING_STYLE', 'path')
AWS_S3_URL_PROTOCOL = os.getenv('AWS_S3_URL_PROTOCOL', 'https:')
AWS_QUERYSTRING_AUTH = os.getenv('AWS_QUERYSTRING_AUTH', 'False').lower() in ('true', '1', 'yes')
AWS_S3_FILE_OVERWRITE = False
AWS_DEFAULT_ACL = os.getenv('AWS_DEFAULT_ACL', 'public-read')
# Bucket riêng cho artifact nội bộ (chỉ mục vector) — KHÔNG public.
AWS_S3_INTERNAL_BUCKET = os.getenv('AWS_S3_INTERNAL_BUCKET', f"{AWS_STORAGE_BUCKET_NAME}-internal")

_S3_CONFIGURED = bool(
    AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY and AWS_S3_ENDPOINT_URL
    and (USE_S3_MEDIA or USE_S3_STATIC)
)
_s3_public = (AWS_S3_CUSTOM_DOMAIN or AWS_S3_ENDPOINT_URL).replace('https://', '').replace('http://', '').rstrip('/')


def _s3_options(location: str = '') -> dict:
    return {
        'access_key': AWS_ACCESS_KEY_ID,
        'secret_key': AWS_SECRET_ACCESS_KEY,
        'bucket_name': AWS_STORAGE_BUCKET_NAME,
        'region_name': AWS_S3_REGION_NAME,
        'endpoint_url': AWS_S3_ENDPOINT_URL,
        'addressing_style': AWS_S3_ADDRESSING_STYLE,
        'custom_domain': AWS_S3_CUSTOM_DOMAIN or None,
        'querystring_auth': AWS_QUERYSTRING_AUTH,
        'file_overwrite': AWS_S3_FILE_OVERWRITE,
        'default_acl': AWS_DEFAULT_ACL or None,
        'location': location,
        'object_parameters': {'CacheControl': 'public, max-age=86400'},
    }


STORAGES = {
    'default': {'BACKEND': 'django.core.files.storage.FileSystemStorage'},
    'staticfiles': {'BACKEND': 'whitenoise.storage.CompressedStaticFilesStorage'},
}

if _S3_CONFIGURED:
    if USE_S3_MEDIA:
        STORAGES['default'] = {'BACKEND': 'storages.backends.s3.S3Storage', 'OPTIONS': _s3_options('')}
        MEDIA_URL = f"{AWS_S3_URL_PROTOCOL}//{_s3_public}/"
    if USE_S3_STATIC:
        STORAGES['staticfiles'] = {'BACKEND': 'storages.backends.s3.S3Storage', 'OPTIONS': _s3_options('static')}
        STATIC_URL = f"{AWS_S3_URL_PROTOCOL}//{_s3_public}/static/"
    _s3_endpoint_hostname = (AWS_S3_ENDPOINT_URL or '').replace('https://', '').replace('http://', '').split(':')[0].split('/')[0]
    for _h in {_s3_public.split('/')[0], _s3_endpoint_hostname}:
        if _h and _h not in ALLOWED_HOSTS:
            ALLOWED_HOSTS.append(_h)

