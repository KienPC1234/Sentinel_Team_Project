# Redis Channel Layers for WebSockets
CHANNEL_LAYERS = {
    'default': {
        'BACKEND': 'channels_redis.core.RedisChannelLayer',
        'CONFIG': {
            'hosts': [{
                'address': f'redis://{REDIS_HOST}:{REDIS_PORT}',
                'socket_timeout': 30,          # Must be > brpop_timeout (5s) to avoid read timeout on nil responses
                'socket_connect_timeout': 10,
                'retry_on_timeout': True,
                'health_check_interval': 15,
            }],
            'capacity': 512,        # max messages per channel before backpressure (default 100)
            'expiry': 60,           # seconds a message survives in the layer before being dropped
        },
    },
}

