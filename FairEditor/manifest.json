{
  "manifest_version": 3,
  "name": "FairEditor by ShieldCall",
  "version": "1.0.0",
  "description": "Real-time gender bias detection and empathetic writing assistant powered by ShieldCall VN.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "https://cs.fptoj.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
